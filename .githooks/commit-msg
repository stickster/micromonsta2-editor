#!/usr/bin/env sh
# Commit-msg hook: Validate that the commit message follows Conventional Commits
# and is not a generic/vague placeholder message.

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE" | tr -d '\r')

# Allow merge/revert/fixup commits generated by Git
if echo "$FIRST_LINE" | grep -qE '^(Merge |Revert |fixup! |squash! )'; then
    exit 0
fi

# Enforce Conventional Commits pattern: type(optional-scope): description
if ! echo "$FIRST_LINE" | grep -qE '^(feat|fix|refactor|style|test|docs|chore|perf|ci|build)(\([a-z0-9_-]+\))?!?: .+'; then
    echo ""
    echo "[commit-msg] ❌ Invalid commit message format:"
    echo "  \"$FIRST_LINE\""
    echo ""
    echo "Commit subject must follow Conventional Commits:"
    echo "  <type>(<optional-scope>): <imperative summary>"
    echo ""
    echo "Examples:"
    echo "  feat(chorder): highlight diatonic chord notes on audition keyboard"
    echo "  fix(ui): map 25-key audition keyboard offsets without modulo wrap"
    echo "  refactor(editor): move hardware knob assignments above mod matrix"
    echo ""
    exit 1
fi

# Check max length (72 chars)
LEN=${#FIRST_LINE}
if [ "$LEN" -gt 72 ]; then
    echo ""
    echo "[commit-msg] ❌ Commit subject line is too long ($LEN > 72 characters):"
    echo "  \"$FIRST_LINE\""
    echo "Keep the summary concise and move details to the commit body."
    exit 1
fi

# Disallow trailing period on subject line
if echo "$FIRST_LINE" | grep -qE '\.$'; then
    echo ""
    echo "[commit-msg] ❌ Commit subject line must not end with a period:"
    echo "  \"$FIRST_LINE\""
    exit 1
fi

exit 0
